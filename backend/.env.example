ENV=dev
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/app
QDRANT_URL=http://localhost:6333
API_KEY_SALT=change-me-super-secret
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# AI providers
EMBEDDING_PROVIDER=openai
CHAT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# ---- Voice agent (widget voice + phone calls) ----
# Uses OPENAI_API_KEY above. Widget voice needs only that.
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
REALTIME_VOICE=marin
# Optional separate secret for signing voice session tokens (defaults to API_KEY_SALT)
VOICE_TOKEN_SECRET=
VOICE_MAX_WEB_SESSION_SECONDS=600
VOICE_MAX_PHONE_CALL_SECONDS=1200
VOICE_CALLBACK_WORKER_ENABLED=true
VOICE_CALLBACK_POLL_SECONDS=15

# ---- Phone calls / missed-call callbacks (Twilio) ----
# Public HTTPS URL of this backend as Twilio sees it (ngrok URL in development)
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Keep true in production. Only set false for local experiments.
TWILIO_VALIDATE_SIGNATURES=true
